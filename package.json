{
  "name": "python-profiler",
  "displayName": "Python Profiler (Tachyon)",
  "description": "CPU, memory and asyncio profiling for Python 3.15+ inside VS Code: live flame graphs, editor heat maps, leak hunting and event-loop diagnostics. Launch or attach, on Windows, Linux and macOS.",
  "version": "0.1.0",
  "publisher": "vspyprof",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MkKiefer/vs-python-profiler.git"
  },
  "bugs": {
    "url": "https://github.com/MkKiefer/vs-python-profiler/issues"
  },
  "homepage": "https://github.com/MkKiefer/vs-python-profiler#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b2433",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": "^20.19.0 || >=22.12.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "python",
    "profiler",
    "flamegraph",
    "tachyon",
    "asyncio",
    "memory",
    "performance"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Profiling and attaching run Python from the workspace and need a trusted workspace. Saved .vspyprof profiles open in Restricted Mode.",
      "restrictedConfigurations": [
        "vspyprof.pythonPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Profiling runs a local Python interpreter."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onDebugResolve:python-profiler",
    "onDebugDynamicConfigurations:python-profiler",
    "onCustomEditor:vspyprof.profileViewer",
    "workspaceContains:**/*.py"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vspyprof.profileFile",
        "title": "Profile Python File",
        "category": "Python Profiler",
        "icon": "$(flame)"
      },
      {
        "command": "vspyprof.profileConfiguration",
        "title": "Profile Launch Configuration\u2026",
        "category": "Python Profiler",
        "icon": "$(debug-alt)"
      },
      {
        "command": "vspyprof.profileTest",
        "title": "Profile Test at Cursor",
        "category": "Python Profiler"
      },
      {
        "command": "vspyprof.attach",
        "title": "Attach Profiler to Process\u2026",
        "category": "Python Profiler",
        "icon": "$(plug)"
      },
      {
        "command": "vspyprof.attachProcess",
        "title": "Attach Profiler",
        "category": "Python Profiler",
        "icon": "$(plug)"
      },
      {
        "command": "vspyprof.stop",
        "title": "Stop Profiling",
        "category": "Python Profiler",
        "icon": "$(debug-stop)"
      },
      {
        "command": "vspyprof.stopAndTerminate",
        "title": "Stop Profiling and Terminate Program",
        "category": "Python Profiler",
        "icon": "$(trash)"
      },
      {
        "command": "vspyprof.openDashboard",
        "title": "Open Profile Dashboard",
        "category": "Python Profiler",
        "icon": "$(graph)"
      },
      {
        "command": "vspyprof.snapshot",
        "title": "Take Memory Snapshot",
        "category": "Python Profiler",
        "icon": "$(device-camera)"
      },
      {
        "command": "vspyprof.toggleTracemalloc",
        "title": "Toggle Memory Tracing (tracemalloc)",
        "category": "Python Profiler"
      },
      {
        "command": "vspyprof.toggleAsyncioDebug",
        "title": "Toggle asyncio Debug Mode",
        "category": "Python Profiler"
      },
      {
        "command": "vspyprof.mark",
        "title": "Add Timeline Marker\u2026",
        "category": "Python Profiler",
        "icon": "$(bookmark)"
      },
      {
        "command": "vspyprof.toggleHeat",
        "title": "Toggle Editor Heat Map",
        "category": "Python Profiler",
        "icon": "$(flame)"
      },
      {
        "command": "vspyprof.openProfile",
        "title": "Open Profile File\u2026",
        "category": "Python Profiler",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vspyprof.saveProfile",
        "title": "Save Profile As\u2026",
        "category": "Python Profiler",
        "icon": "$(save)"
      },
      {
        "command": "vspyprof.export",
        "title": "Export Profile (speedscope / collapsed stacks)\u2026",
        "category": "Python Profiler"
      },
      {
        "command": "vspyprof.refreshProcesses",
        "title": "Refresh",
        "category": "Python Profiler",
        "icon": "$(refresh)"
      },
      {
        "command": "vspyprof.selectSession",
        "title": "Show Session",
        "category": "Python Profiler"
      },
      {
        "command": "vspyprof.removeSession",
        "title": "Remove Session",
        "category": "Python Profiler",
        "icon": "$(close)"
      },
      {
        "command": "vspyprof.deleteSession",
        "title": "Delete Saved Profile",
        "category": "Python Profiler",
        "icon": "$(trash)"
      },
      {
        "command": "vspyprof.revealFunction",
        "title": "Show in Dashboard",
        "category": "Python Profiler"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vspyprof.profileFile",
          "when": "resourceLangId == python",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "vspyprof.profileFile",
          "when": "resourceLangId == python",
          "group": "vspyprof@1"
        },
        {
          "command": "vspyprof.profileTest",
          "when": "resourceLangId == python && resourceFilename =~ /^test_|_test\\.py$/",
          "group": "vspyprof@2"
        }
      ],
      "explorer/context": [
        {
          "command": "vspyprof.profileFile",
          "when": "resourceLangId == python",
          "group": "vspyprof@1"
        }
      ],
      "view/title": [
        {
          "command": "vspyprof.profileFile",
          "when": "view == vspyprof.sessions",
          "group": "navigation@1"
        },
        {
          "command": "vspyprof.attach",
          "when": "view == vspyprof.sessions",
          "group": "navigation@2"
        },
        {
          "command": "vspyprof.openProfile",
          "when": "view == vspyprof.sessions",
          "group": "navigation@3"
        },
        {
          "command": "vspyprof.refreshProcesses",
          "when": "view == vspyprof.processes",
          "group": "navigation"
        },
        {
          "command": "vspyprof.toggleHeat",
          "when": "view == vspyprof.hotspots",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vspyprof.attachProcess",
          "when": "view == vspyprof.processes && viewItem == process",
          "group": "inline"
        },
        {
          "command": "vspyprof.stop",
          "when": "view == vspyprof.sessions && viewItem == session.live",
          "group": "inline@1"
        },
        {
          "command": "vspyprof.openDashboard",
          "when": "view == vspyprof.sessions && viewItem =~ /^session\\.(live|done)$/",
          "group": "inline@0"
        },
        {
          "command": "vspyprof.snapshot",
          "when": "view == vspyprof.sessions && viewItem == session.live",
          "group": "1_actions@1"
        },
        {
          "command": "vspyprof.stopAndTerminate",
          "when": "view == vspyprof.sessions && viewItem == session.live",
          "group": "1_actions@2"
        },
        {
          "command": "vspyprof.saveProfile",
          "when": "view == vspyprof.sessions && viewItem =~ /^session\\.(live|done)$/",
          "group": "1_actions@3"
        },
        {
          "command": "vspyprof.deleteSession",
          "when": "view == vspyprof.sessions && viewItem == session.saved",
          "group": "inline@2"
        },
        {
          "command": "vspyprof.export",
          "when": "view == vspyprof.sessions && viewItem =~ /^session\\.(live|done)$/",
          "group": "1_actions@4"
        },
        {
          "command": "vspyprof.removeSession",
          "when": "view == vspyprof.sessions && viewItem == session.done",
          "group": "inline@2"
        },
        {
          "command": "vspyprof.removeSession",
          "when": "view == vspyprof.sessions && viewItem =~ /^session\\.(live|done)$/",
          "group": "2_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vspyprof.attachProcess",
          "when": "false"
        },
        {
          "command": "vspyprof.selectSession",
          "when": "false"
        },
        {
          "command": "vspyprof.deleteSession",
          "when": "false"
        },
        {
          "command": "vspyprof.revealFunction",
          "when": "false"
        },
        {
          "command": "vspyprof.stop",
          "when": "vspyprof.hasLiveSession"
        },
        {
          "command": "vspyprof.stopAndTerminate",
          "when": "vspyprof.hasLiveSession"
        },
        {
          "command": "vspyprof.snapshot",
          "when": "vspyprof.hasLiveSession"
        },
        {
          "command": "vspyprof.mark",
          "when": "vspyprof.hasLiveSession"
        },
        {
          "command": "vspyprof.removeSession",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vspyprof",
          "title": "Python Profiler",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "vspyprof": [
        {
          "id": "vspyprof.sessions",
          "name": "Sessions"
        },
        {
          "id": "vspyprof.processes",
          "name": "Python Processes",
          "visibility": "collapsed"
        },
        {
          "id": "vspyprof.hotspots",
          "name": "Hotspots"
        },
        {
          "id": "vspyprof.tasks",
          "name": "Async Tasks",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vspyprof.sessions",
        "contents": "Profile Python 3.15+ programs with the built-in Tachyon sampling profiler.\n[$(flame) Profile Current File](command:vspyprof.profileFile)\n[$(debug-alt) Profile a Launch Configuration](command:vspyprof.profileConfiguration)\n[$(plug) Attach to Running Process](command:vspyprof.attach)\n[Open a .vspyprof file](command:vspyprof.openProfile)"
      }
    ],
    "customEditors": [
      {
        "viewType": "vspyprof.profileViewer",
        "displayName": "Python Profile",
        "selector": [
          {
            "filenamePattern": "*.vspyprof"
          }
        ],
        "priority": "default"
      }
    ],
    "debuggers": [
      {
        "type": "python-profiler",
        "label": "Python Profiler",
        "languages": [
          "python"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "Python file to profile.",
                "default": "${file}"
              },
              "module": {
                "type": "string",
                "description": "Module to run with `-m` (e.g. uvicorn, pytest, mypkg.cli)."
              },
              "args": {
                "type": [
                  "array",
                  "string"
                ],
                "description": "Command line arguments.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Extra environment variables.",
                "default": {}
              },
              "envFile": {
                "type": "string",
                "description": "Path to a .env file."
              },
              "python": {
                "type": "string",
                "description": "Interpreter path. Defaults to the interpreter selected in the Python extension."
              },
              "profile": {
                "type": "object",
                "description": "Profiler options.",
                "properties": {
                  "rateHz": {
                    "type": "number",
                    "default": 1000
                  },
                  "memory": {
                    "type": "boolean",
                    "description": "Start tracemalloc at launch.",
                    "default": false
                  },
                  "asyncioDebug": {
                    "type": "boolean",
                    "default": false
                  },
                  "native": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          },
          "attach": {
            "properties": {
              "processId": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "PID to attach to. Leave empty to pick a process.",
                "default": "${command:vspyprof.pickProcess}"
              },
              "profile": {
                "type": "object",
                "properties": {
                  "rateHz": {
                    "type": "number",
                    "default": 1000
                  },
                  "memory": {
                    "type": "boolean",
                    "default": false
                  },
                  "asyncioDebug": {
                    "type": "boolean",
                    "default": false
                  },
                  "inject": {
                    "type": "boolean",
                    "description": "Inject the in-process agent (memory, asyncio debug) via sys.remote_exec.",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Python Profiler: Current File",
            "body": {
              "name": "Profile: Current File",
              "type": "python-profiler",
              "request": "launch",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Python Profiler: Module",
            "body": {
              "name": "Profile: Module",
              "type": "python-profiler",
              "request": "launch",
              "module": "${1:mypackage}",
              "args": []
            }
          },
          {
            "label": "Python Profiler: FastAPI (uvicorn)",
            "body": {
              "name": "Profile: FastAPI",
              "type": "python-profiler",
              "request": "launch",
              "module": "uvicorn",
              "args": [
                "${1:app.main}:app",
                "--port",
                "8000"
              ],
              "profile": {
                "asyncioDebug": true
              }
            }
          },
          {
            "label": "Python Profiler: Django",
            "body": {
              "name": "Profile: Django",
              "type": "python-profiler",
              "request": "launch",
              "program": "^\"\\${workspaceFolder}/manage.py\"",
              "args": [
                "runserver",
                "--noreload"
              ]
            }
          },
          {
            "label": "Python Profiler: pytest",
            "body": {
              "name": "Profile: pytest",
              "type": "python-profiler",
              "request": "launch",
              "module": "pytest",
              "args": [
                "-x",
                "${1:tests}"
              ]
            }
          },
          {
            "label": "Python Profiler: Attach",
            "body": {
              "name": "Profile: Attach",
              "type": "python-profiler",
              "request": "attach",
              "processId": "^\"\\${command:vspyprof.pickProcess}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Python Profiler",
      "properties": {
        "vspyprof.samplingRate": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 20000,
          "description": "Stack samples per second. Tachyon reads the target from outside; at 1 kHz the measured slowdown is under 1 %."
        },
        "vspyprof.blockingSampling": {
          "type": "boolean",
          "default": false,
          "description": "Pause the target's threads for each sample (Tachyon --blocking). Removes discarded/torn samples on busy multi-threaded programs, but slows the target (measured 15\u201325 % at 1 kHz)."
        },
        "vspyprof.memory.tracemallocOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Start tracemalloc when a session starts. tracemalloc slows allocation-heavy code several times over (measured 6\u00d7 with 1 frame, over 20\u00d7 with 8 or more), so turn it on while you hunt a leak, not while you measure CPU time."
        },
        "vspyprof.memory.tracebackFrames": {
          "type": "number",
          "default": 16,
          "description": "Frames recorded per allocation by tracemalloc."
        },
        "vspyprof.asyncio.debugOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Enable asyncio debug mode (slow callback detection, never-awaited coroutines) when a session starts."
        },
        "vspyprof.asyncio.slowCallbackMs": {
          "type": "number",
          "default": 100,
          "description": "Callbacks that block the event loop longer than this are reported."
        },
        "vspyprof.nativeFrames": {
          "type": "boolean",
          "default": false,
          "description": "Show <native> frames for time spent in C code."
        },
        "vspyprof.heatMap.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show gutter heat and inline timings in the editor for the active session."
        },
        "vspyprof.heatMap.metric": {
          "type": "string",
          "enum": [
            "self",
            "total"
          ],
          "default": "total",
          "description": "Which per-line value drives the editor heat map."
        },
        "vspyprof.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show profile CodeLens above hot functions."
        },
        "vspyprof.followChildren": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "What to do when a profiled program starts Python child processes (multiprocessing, workers)."
        },
        "vspyprof.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Save every finished session as a .vspyprof file in the workspace storage so it shows up under Sessions."
        },
        "vspyprof.openDashboardOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Open the dashboard when a session starts."
        },
        "vspyprof.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Interpreter to use when the Python extension is unavailable."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build --mode development",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "vue-tsc --build",
    "lint": "eslint src test",
    "test": "npm run test:extension && npm run test:webview",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:python": "cd python && pdm run check",
    "test:python": "cd python && pdm run test",
    "test:integration": "cd python && pdm run test:integration",
    "package": "node esbuild.mjs --production && vite build && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production && vite build",
    "test:extension": "node esbuild.mjs --tests && node --test dist-test/*.test.cjs",
    "test:webview": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vscode/vsce": "^3.6.0",
    "@vue/compiler-core": "^3.5.45",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.6",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  }
}
